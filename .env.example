APP_NAME="OTC Signal Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=otc_signal_intelligence
DB_USERNAME=otc_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ──────────────────────────────────────────────
# Queue
# ──────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ──────────────────────────────────────────────
# Cache & Session
# ──────────────────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ──────────────────────────────────────────────
# Broadcasting (Laravel Reverb / WebSocket)
# ──────────────────────────────────────────────
BROADCAST_DRIVER=reverb
REVERB_APP_ID=otc-signal-app
REVERB_APP_KEY=otc-signal-key
REVERB_APP_SECRET=otc-signal-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ──────────────────────────────────────────────
# Quotex Adapter
# Fill these when integrating a real Quotex connection.
# QUOTEX_SESSION_TOKEN comes from an authenticated browser session cookie.
# ──────────────────────────────────────────────
QUOTEX_ADAPTER_ENABLED=false
QUOTEX_WS_URL=
QUOTEX_SESSION_TOKEN=
QUOTEX_ACCOUNT_TYPE=demo

# ──────────────────────────────────────────────
# Broker
# ──────────────────────────────────────────────
DEFAULT_BROKER=mock
MOCK_BROKER_SEED=42

# ──────────────────────────────────────────────
# Feature Flags
# Enable with extreme caution in production
# ──────────────────────────────────────────────
USE_MOCK_DATA=true
ENABLE_QUOTEX_ADAPTER=false
ENABLE_AUTO_SCAN=false
ENABLE_NOTIFICATIONS=false
ENABLE_REAL_ACCOUNT_ACTIONS=false

# ──────────────────────────────────────────────
# Signal Engine
# ──────────────────────────────────────────────
DEFAULT_CONFIDENCE_THRESHOLD=70
DEFAULT_MIN_DATA_QUALITY=80
DEFAULT_MIN_CANDLE_HISTORY=200
MAX_SIGNALS_PER_HOUR=10
SIGNAL_COOLDOWN_SECONDS=60

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────
# Mail (optional notifications)
# ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@otcsignal.local"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Frontend (Next.js public environment variables)
# These are exposed to the browser — never put secrets here
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_NAME="OTC Signal Intelligence"
NEXT_PUBLIC_DEMO_MODE=true

# ──────────────────────────────────────────────
# Encryption
# Additional symmetric key for encrypting broker credentials at rest.
# Generate: openssl rand -hex 32
# ──────────────────────────────────────────────
ENCRYPTION_KEY=
